# Copy to .env and fill in. Never commit .env.

# Ethereum RPC endpoint (chain id 1).
# For production use a dedicated provider (Alchemy, Infura, QuickNode).
# Public fallback: https://eth.llamarpc.com
RPC_URL=

# Hex private key of the deployer wallet (64 chars, 0x prefix optional).
# Use a DEDICATED deployer wallet, never your main wallet.
PRIVATE_KEY=

# Filled in after running the deploy script
CONTRACT_ADDRESS=

# Collection details (passed to the contract constructor)
COLLECTION_NAME=My Collection
COLLECTION_SYMBOL=MYC
MAX_SUPPLY=10000
MAX_PER_WALLET=5

# Mint price in ETH (decimal string, e.g. "0.05")
MINT_PRICE=0.05

# Base URI for token metadata (must end with a trailing slash).
# Token #1 resolves to <BASE_URI>1, token #2 to <BASE_URI>2, etc.
BASE_URI=ipfs://YOUR_CID/

# Mint script options (MINT_TO defaults to the deployer wallet)
MINT_TO=
MINT_QUANTITY=1
